[Unit]
Description=Update verified Alibaba Cloud source-IP allowlist
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=360
ExecStart=/usr/bin/docker run --rm --init --name alibaba-allowlist-update --pull never --network host --cap-drop ALL --security-opt no-new-privileges --read-only --memory 256m --mount type=bind,src=/root/aiclient-country-data,dst=/data --entrypoint node aiclient2api:alibaba-allowlist-updater scripts/ops/update-alibaba-allowlist.mjs --output /data/alibaba-allowlist.json --exceptions-file /data/explicit-ip-allowlist.json --apply --runtime-url http://127.0.0.1:13000/runtime/health --edge-health-url http://127.0.0.1:18081/health
# --rm removes a successful oneshot before systemd runs ExecStop.
ExecStop=-/usr/bin/docker stop -t 10 alibaba-allowlist-update
